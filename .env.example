# Local PostgreSQL fallback (development only)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Supabase PostgreSQL — copy the Shared/Session Pooler URL from:
# Supabase Dashboard > Project > Connect
# This takes priority over DATABASE_URL when configured.
SUPABASE_DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-[region].pooler.supabase.com:5432/postgres

# Optional Supabase platform credentials (server-only; do not use NEXT_PUBLIC_)
SUPABASE_URL=https://[project-ref].supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Keep false unless your deployment has the Supabase Root CA configured.
SUPABASE_SSL_REJECT_UNAUTHORIZED=false
DB_POOL_MAX=5

# Set true only when you want to re-enable cookie login pages.
APP_AUTH_ENABLED=false

# Admin bootstrap account for a new database
ADMIN_NAME=Admin Faveda
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-before-production
ADMIN_SECRET=replace-with-a-long-random-secret
